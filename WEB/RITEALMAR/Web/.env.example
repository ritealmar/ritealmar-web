# Placeholder environment variables. NEVER commit real secrets to the repository.
# Replace values in your deployment secrets manager (Cloudflare/Firebase/CI), not here.

# Public / non-secret values (example placeholders)
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_TURNSTILE_SITE_KEY=tu_site_key_publica

# Sensitive keys (place them in secrets, do NOT commit real values here)
# GEMINI_API_KEY: poner_en_secrets_no_en_repo
GEMINI_API_KEY=poner_en_secrets_no_en_repo
# RESEND_API_KEY: poner_en_secrets_no_en_repo
RESEND_API_KEY=poner_en_secrets_no_en_repo
# GOOGLE_SHEETS_URL: poner_en_cloudflare_secret_no_en_repo
GOOGLE_SHEETS_URL=poner_en_cloudflare_secret_no_en_repo
# VITE_GOOGLE_SHEETS_WEBHOOK_URL: si se necesita para integraciones, mover a backend y usar secret
VITE_GOOGLE_SHEETS_WEBHOOK_URL=poner_en_cloudflare_secret_no_en_repo

# APP_URL: URL pública de la aplicación
APP_URL=TU_APP_URL
