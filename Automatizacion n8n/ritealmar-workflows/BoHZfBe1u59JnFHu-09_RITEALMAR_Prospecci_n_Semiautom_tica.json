    {
      "parameters": {
        "jsCode": "const candidatas = $('06 - Filtrar Empresas con Datos Comerciales')\n  .all()\n  .map(item => item.json);\n\nconst crm = $input.all().map(item => item.json);\n\nfunction texto(valor) {\n  return String(valor ?? '')\n    .normalize('NFD')\n    .replace(/[\\u0300-\\u036f]/g, '')\n    .toLowerCase()\n    .trim()\n    .replace(/[^a-z0-9]+/g, ' ')\n    .replace(/\\s+/g, ' ')\n    .trim();\n}\n\nfunction dominio(valor) {\n  let web = String(valor ?? '').trim().toLowerCase();\n\n  if (!web) return '';\n\n  try {\n    if (!/^https?:\\/\\//i.test(web)) {\n      web = 'https://' + web;\n    }\n\n    return new URL(web).hostname\n      .replace(/^www\\./, '')\n      .toLowerCase();\n  } catch {\n    return web\n      .replace(/^https?:\\/\\//, '')\n      .replace(/^www\\./, '')\n      .split('/')[0]\n      .trim();\n  }\n}\n\nfunction telefono(valor) {\n  const digitos = String(valor ?? '').replace(/\\D/g, '');\n\n  if (!digitos) return '';\n\n  // En España permite comparar:\n  // +34 911 111 111\n  // con 911111111\n  return digitos.length >= 9\n    ? digitos.slice(-9)\n    : digitos;\n}\n\nconst nombresGenericos = new Set([\n  'clinica dental',\n  'dentista',\n  'dental',\n  'odontologia',\n]);\n\nfunction esDuplicada(candidata) {\n  const nombreCandidato = texto(candidata.Empresa);\n  const webCandidata = dominio(candidata.Web);\n  const telefonoCandidato = telefono(candidata['Teléfono']);\n\n  return crm.some(fila => {\n    const nombreCRM = texto(fila.Empresa);\n    const webCRM = dominio(fila.Web);\n    const telefonoCRM = telefono(fila['Teléfono']);\n\n    const mismaWeb =\n      webCandidata &&\n      webCRM &&\n      webCandidata === webCRM;\n\n    const mismoTelefono =\n      telefonoCandidato &&\n      telefonoCRM &&\n      telefonoCandidato === telefonoCRM;\n\n    const mismoNombre =\n      nombreCandidato &&\n      nombreCRM &&\n      !nombresGenericos.has(nombreCandidato) &&\n      nombreCandidato === nombreCRM;\n\n    return mismaWeb || mismoTelefono || mismoNombre;\n  });\n}\n\nconst nuevas = candidatas.filter(candidata => !esDuplicada(candidata));\n\nreturn nuevas.map(candidata => ({\n  json: candidata,\n}));"
      },
