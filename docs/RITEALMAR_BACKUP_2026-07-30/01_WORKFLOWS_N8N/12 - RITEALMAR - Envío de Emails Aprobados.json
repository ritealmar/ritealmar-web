    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nfunction fechaMadrid(fecha) {\n  return new Date(fecha)\n    .toLocaleString('es-ES', {\n      timeZone: 'Europe/Madrid',\n      day: '2-digit',\n      month: '2-digit',\n      year: 'numeric',\n      hour: '2-digit',\n      minute: '2-digit',\n      second: '2-digit',\n      hour12: false,\n    })\n    .replace(',', '');\n}\n\nreturn items.map((item, index) => {\n\n  // Respuesta real devuelta por Gmail\n  const gmail = item.json;\n\n  // Recuperamos el prospecto que originó este envío\n  const origen =\n    $('04 - Verificar que el Email No Fue Enviado')\n      .itemMatching(index)\n      .json;\n\n  const ahora = new Date();\n\n  // Próximo seguimiento: 2 días después del envío\n  const proximoSeguimiento =\n    new Date(\n      ahora.getTime() +\n      (2 * 24 * 60 * 60 * 1000)\n    );\n\n  const messageId =\n    gmail.id ||\n    gmail.messageId ||\n    gmail.message_id ||\n    '';\n\n  const threadId =\n    gmail.threadId ||\n    gmail.thread_id ||\n    '';\n\n  if (!messageId) {\n    throw new Error(\n      `SEGURIDAD: Gmail no devolvió Message ID para ${\n        origen.Empresa || 'empresa desconocida'\n      }`\n    );\n  }\n\n  return {\n    json: {\n\n      row_number:\n        origen.row_number,\n\n      Empresa:\n        origen.Empresa || '',\n\n      'Último Contacto':\n        fechaMadrid(ahora),\n\n      'Próximo Seguimiento':\n        fechaMadrid(proximoSeguimiento),\n\n      'Thread Gmail':\n        threadId,\n\n      'Message ID':\n        messageId,\n\n      Estado:\n        'Contactado',\n\n      'Estado Email Comercial':\n        'Enviado',\n\n      'Fecha Actualización':\n        fechaMadrid(ahora)\n    },\n\n    pairedItem: {\n      item: index\n    }\n  };\n});"
      },
