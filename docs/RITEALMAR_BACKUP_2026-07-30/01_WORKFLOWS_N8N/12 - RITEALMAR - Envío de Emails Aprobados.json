      "parameters": {
        "jsCode": "const items = $input.all();\n\nfunction fechaMadrid(fecha) {\n  return fecha\n    .toLocaleString('es-ES', {\n      timeZone: 'Europe/Madrid',\n      day: '2-digit',\n      month: '2-digit',\n      year: 'numeric',\n      hour: '2-digit',\n      minute: '2-digit',\n      second: '2-digit',\n      hour12: false,\n    })\n    .replace(',', '');\n}\n\nconst ahora = new Date();\n\nconst proximoSeguimiento = new Date(\n  ahora.getTime() + (2 * 24 * 60 * 60 * 1000)\n);\n\nreturn items.map((item, index) => {\n\n  const original = $(\n    '02D - Preparar Vista Previa de Envío Automático'\n  )\n    .itemMatching(index)\n    .json;\n\n  const gmail = item.json || {};\n\n  return {\n    json: {\n      row_number: original.row_number,\n\n      Empresa:\n        original.Empresa ||\n        '',\n\n      Estado: 'Contactado',\n\n      'Último Contacto':\n        fechaMadrid(ahora),\n\n      'Próximo Seguimiento':\n        fechaMadrid(proximoSeguimiento),\n\n      'Thread Gmail':\n        gmail.threadId ||\n        gmail.thread_id ||\n        '',\n\n      'Message ID':\n        gmail.id ||\n        gmail.messageId ||\n        gmail.message_id ||\n        '',\n\n      'Estado Email Comercial':\n        'Enviado',\n\n      'Fecha Actualización':\n        fechaMadrid(ahora)\n    }\n  };\n});"
